
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Server Health Schema",
    "description": "Validates server health information",
    "type": "object",
    "minProperties": 1,
    "additionalProperties": {
        "type": "object",
        "required": ["cpu", "memory", "status"],
        "properties": {
            "cpu": {
                "type": "string",
                "pattern": "^[0-9]{1,3}%$"
            },
            "memory": {
                "type": "string",
                "pattern": "^[0-9]{1,3}%$"
            },
            "status": {
                "type": "string",
                "enum": [
                    "Healthy",
                    "Warning",
                    "Critical",
                    "Error"
                ]
            }
        },
        "additionalProperties": false
    }
}